[Unit]
Description=Synora mirror sync manager (scheduler + API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=synora
RuntimeDirectoryMode=0755
PIDFile=/run/synora/manager.pid
ExecStart=/usr/local/bin/synora-manager -c /etc/synora/synora.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
User=root
Group=root
LimitNOFILE=65536
# NOTE: namespace hardening omitted — the unit must also work inside
# containers, where these namespaces are unavailable (systemd 226/NAMESPACE).

[Install]
WantedBy=multi-user.target
